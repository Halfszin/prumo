{
  "name": "prumo",
  "version": "0.13.5",
  "description": "Prumo: organizador de arquivos open source para Windows",
  "author": "Halfszin e colaboradores do Prumo",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node test/extras.test.js && node test/ids.test.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.prumo.app",
    "productName": "Prumo",
    "files": [
      "main.js",
      "preload.js",
      "fsops.js",
      "background.js",
      "extras.js",
      "search-worker.js",
      "renderer/**",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "artifactName": "Prumo-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Halfszin",
        "repo": "prumo",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      "THIRD_PARTY_LICENSES.txt",
      "PRIVACIDADE.md",
      "TERMOS.md",
      "LICENSE"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.10.38",
    "read-excel-file": "^5.8.6"
  }
}
